# Copy this file to apps/web/.env.local and replace the fake values with real ones.
# Never commit real keys. .env files are ignored by git (only .env.example is committed).

# Public: safe to expose in the browser (the NEXT_PUBLIC_ prefix makes Next.js send it to the client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Secret: server-only. Never use this in client code or the extension, and never share it
# (not in chat, issues, PRs, or commits).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server-only API allowlist. Exact origins, comma-separated; no trailing slashes.
# Set this explicitly on Vercel, including any approved preview website origins.
API_ALLOWED_WEB_ORIGINS=http://localhost:3000

# Chrome extension IDs from chrome://extensions, comma-separated.
# Empty disables extension origins until the extension is configured.
API_ALLOWED_EXTENSION_IDS=
